{
  "name": "@tscircuit/cad-collision-checking",
  "version": "0.0.3",
  "description": "Step-based continuous collision checking for CAD assembly movements",
  "type": "module",
  "module": "lib/index.ts",
  "main": "lib/index.ts",
  "types": "lib/index.ts",
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/cad-collision-checking"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "cosmos",
    "build:site": "cosmos-export"
  },
  "dependencies": {
    "manifold-3d": "3.5.4"
  },
  "peerDependencies": {
    "@tscircuit/solver-utils": "*",
    "graphics-debug": "*",
    "typescript": "^5",
    "@tscircuit/graphics-debug-3d": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@jscad/modeling": "2.13.0",
    "@tscircuit/graphics-debug-3d": "https://jscdn.tscircuit.com/@tscircuit/graphics-debug-3d/0.0.1.tgz",
    "@tscircuit/modelprinter": "0.0.35",
    "@tscircuit/solver-utils": "^0.0.25",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.13",
    "fast-png": "^8.0.0",
    "graphics-debug": "^0.0.95",
    "jscad-electronics": "0.0.242",
    "poppygl": "0.0.38",
    "react": "^19.1.1",
    "react-cosmos": "^7.0.0",
    "react-cosmos-plugin-vite": "^7.0.0",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "overrides": {
    "@tscircuit/graphics-debug-3d": "https://jscdn.tscircuit.com/@tscircuit/graphics-debug-3d/0.0.1.tgz"
  }
}

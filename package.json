{
  "name": "@tscircuit/cad-collision-checking",
  "version": "0.0.0",
  "description": "Step-based continuous collision checking for CAD assembly movements",
  "type": "module",
  "module": "lib/index.ts",
  "main": "lib/index.ts",
  "types": "lib/index.ts",
  "files": ["lib"],
  "repository": { "type": "git", "url": "https://github.com/tscircuit/cad-collision-checking" },
  "license": "MIT",
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "cosmos",
    "build:site": "cosmos-export"
  },
  "dependencies": { "manifold-3d": "3.5.4" },
  "peerDependencies": { "@tscircuit/solver-utils": "*", "graphics-debug": "*", "typescript": "^5" },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@tscircuit/solver-utils": "^0.0.23",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.13",
    "bun-match-svg": "^0.0.17",
    "graphics-debug": "^0.0.95",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-cosmos": "^7.0.0",
    "react-cosmos-plugin-vite": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
